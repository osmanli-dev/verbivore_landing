{
	"name": "bulk-import",
	"description": "Custom endpoints for bulk-adding data (certificates, results, and any other list collection) from an uploaded .xlsx file",
	"icon": "upload_file",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-endpoint"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "endpoint",
		"path": "dist/index.js",
		"source": "src/index.js",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"dependencies": {
		"exceljs": "^4.4.0",
		"multer": "^2.0.0"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.0"
	},
	"allowScripts": {
		"esbuild@0.26.0": true,
		"vue-demi@0.14.10": true,
		"esbuild@0.28.1": true
	}
}
